HOST=127.0.0.1
PORT=3000
AI_PROVIDER=lm-studio
DB_PATH=data/assistant.sqlite

# TypeORM syncs the schema by default outside production.
# DB_SYNCHRONIZE=true
AI_PROJECT_NAME=nestjs-assistant
AI_TIME_ZONE=Asia/Shanghai

LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=

AI_TEMPERATURE=0.7
# Request token counts from OpenAI-compatible Chat Completions streams.
# AI_INCLUDE_STREAM_USAGE=true
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_MS=120000
AI_DEEP_MAX_OUTPUT_TOKENS=4096
AI_DEEP_TIMEOUT_MS=240000

AGENT_PROVIDER=lm-studio
AGENT_MODEL=
AGENT_MAX_STEPS=4
AGENT_TIMEOUT_MS=180000
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_DEEP_MAX_OUTPUT_TOKENS=4096
# Optional overrides for the Agent model connection.
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_SEARCH_PROVIDER=deepseek

# Shared by Chat and Agent web search.
DEEPSEEK_SEARCH_API_KEY=
